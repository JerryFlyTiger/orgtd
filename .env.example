# 複製成 .env 後填入。.env 已列入 .gitignore，不會進版控。

# 必填：session 簽章密鑰。產生方式：
#   python -c "import secrets; print(secrets.token_hex(32))"
ORGTD_SECRET_KEY=

# 資料庫
ORGTD_DATABASE_URL=postgresql+psycopg://你的帳號@localhost:5432/orgtd

# 開發模式（正式環境務必留空或設 0）
ORGTD_DEBUG=0

# org 檔存放根目錄，每位使用者一個子資料夾
ORGTD_ORG_ROOT=~/orgtd-data

# 自架單人使用設 1，讓你能在設定頁把資料夾指到 ~/org（Emacs 直接開得到）。
# 對外多人站台必須設 0。
ORGTD_ALLOW_CUSTOM_ORG_DIR=0

# 是否開放註冊
ORGTD_ALLOW_REGISTRATION=1

# 桌面提醒要發給誰（notifier.py 用），留空取最早建立的帳號
ORGTD_NOTIFY_EMAIL=
